<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.0</version>
    <relativePath/>
  </parent>

  <groupId>com.example</groupId>
  <artifactId>caller-service</artifactId>
  <version>0.1.0</version>
  <name>caller-service</name>
  <description>
    Evident example service — triggers a call to receiver-service,
    synchronously or asynchronously, to exercise the framework's trigger,
    polling, and correlation mechanisms. Not part of the published framework.
  </description>

  <properties>
    <!-- Java 25 (current LTS) is the ideal target, but only 8/17/21 are
         installed on this dev machine, and only the JDK 17 install (Maven's
         own default) has a working trust store for Maven Central here —
         JDK 21's separate cacerts fails TLS verification, likely missing a
         corporate root CA. Using 17 rather than fighting the trust store.
         Revisit once 25 (or a properly configured 21) is available. -->
    <java.version>17</java.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
